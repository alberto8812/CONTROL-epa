# Copiá este archivo, renombralo a .env y completá con tus credenciales reales.
# NUNCA commitear el archivo .env

ONEDRIVE_USERNAME=tu_usuario@empresa.com
ONEDRIVE_PASSWORD=tu_contraseña_aqui

# Path personal de SharePoint (OneDrive for Business).
# Lo encontrás en la URL del browser: archacomco-my.sharepoint.com/personal/XXXXX
SHAREPOINT_PERSONAL_PATH=/personal/tu_usuario_dominio_com
